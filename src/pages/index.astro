---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import Layout from "../layouts/Layout.astro";
import Cal from "../components/react/Cal.tsx";
import HomepageWeather from "../components/HomepageWeather.astro";
import HomepageFitness from "../components/HomepageFitness.astro";
import HomepageAiActivity from "../components/HomepageAiActivity.astro";
import HomepageMusic from "../components/HomepageMusic.astro";
import HomepageWatching from "../components/HomepageWatching.astro";
import { experienceJobs, otherExperience } from "../data/portfolio.js";
import bostonHeadshot from "../assets/boston_headshot.jpg";
import grandmaPhoto from "../assets/grandma.webp";
import mikeyPhoto from "../assets/mikey.webp";
import momPhoto from "../assets/mom.webp";
import sashaPhoto from "../assets/sasha.webp";
import journalEntryPhoto from "../assets/journal-taking-a-step.webp";
import journalEntryDetail from "../assets/journal-taking-a-step-detail.webp";

export const prerender = true;
---

<Layout>
  <main class="index-page" id="home">
    <nav class="index-nav" aria-label="Main navigation">
      <a class="index-mark" href="#home">BR / 26</a>
      <div class="index-nav-links">
        <a href="#today">today</a>
        <a href="#experience">experience</a>
        <a href="#contact">contact</a>
      </div>
    </nav>

    <section class="index-hero" aria-labelledby="intro-title">
      <div class="index-hero-copy">
        <div class="index-nameplate" data-season="">
          <h1 id="intro-title">Boston<br />Rohan</h1>
          <div class="index-seasonal-accent" aria-hidden="true">
            <svg class="season-art season-art-autumn" viewBox="0 0 220 100">
              <g class="season-leaf season-leaf-one"
                ><path d="M4 3C19 -3 34 2 42 13C30 22 15 20 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C18 9 28 12 39 14"></path></g
              >
              <g class="season-leaf season-leaf-two"
                ><path d="M4 3C15 -2 28 3 35 13C25 20 12 17 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C16 8 24 11 33 13"></path></g
              >
              <g class="season-leaf season-leaf-three"
                ><path d="M4 3C17 -4 30 1 36 12C25 19 12 17 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C16 8 25 10 34 12"></path></g
              >
              <g class="season-leaf season-leaf-four"
                ><path d="M4 3C18 -3 32 2 40 13C28 21 14 19 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C17 9 27 11 38 13"></path></g
              >
              <g class="season-leaf season-leaf-five"
                ><path d="M4 3C16 -2 27 2 34 11C24 18 12 16 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C15 8 23 10 32 11"></path></g
              >
            </svg>
            <svg class="season-art season-art-winter" viewBox="0 0 220 100">
              <circle
                class="season-flake season-flake-one"
                cx="32"
                cy="17"
                r="2"></circle>
              <circle
                class="season-flake season-flake-two"
                cx="76"
                cy="38"
                r="1.5"></circle>
              <circle
                class="season-flake season-flake-three"
                cx="151"
                cy="23"
                r="2"></circle>
              <circle
                class="season-flake season-flake-four"
                cx="190"
                cy="68"
                r="1.5"></circle>
            </svg>
            <svg class="season-art season-art-spring" viewBox="0 0 220 100">
              <path
                class="season-sprout"
                d="M33 88C34 67 43 50 60 38M44 62C32 58 27 50 29 42C39 44 46 51 44 62ZM48 53C53 40 62 34 72 35C70 46 61 53 48 53Z"
              ></path>
              <path
                class="season-sprout season-sprout-two"
                d="M170 92C170 74 178 61 190 51M177 73C166 70 162 64 164 57C173 59 179 64 177 73Z"
              ></path>
            </svg>
            <svg class="season-art season-art-summer" viewBox="0 0 220 100">
              <circle class="season-sun" cx="175" cy="27" r="9"></circle>
              <path
                class="season-ray"
                d="M175 8V2M175 52V46M156 27H150M200 27H194M161 13L157 9M193 45L189 41M189 13L193 9M157 45L161 41"
              ></path>
            </svg>
          </div>
        </div>
        <p>
          Developer, builder, and person trying to pay attention. Currently
          working at <a href="https://elevationchurch.org/" target="_blank"
            >Elevation Church</a
          >.
        </p>
        <div class="index-current-curiosity">
          <span>currently curious about</span>
          <p>What belongs on a personal website now?</p>
        </div>
      </div>
      <aside class="index-now-rail" aria-label="Current state">
        <Image
          class="index-portrait"
          src={bostonHeadshot}
          alt="Boston Rohan smiling against a dark backdrop"
          width={840}
          height={1050}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
        <div class="index-now-list">
          <div>
            <span>status</span><strong
              class="index-presence"
              data-live-presence
              data-status="unknown"
              title="Checking status"
              aria-live="polite"
              ><i aria-hidden="true"></i><span
                class="index-presence-text"
                data-live-presence-text>checking…</span
              ></strong
            >
          </div>
          <div><span>place</span><strong>Charlotte, NC</strong></div>
          <HomepageWeather server:defer>
            <div slot="fallback">
              <span>weather</span><strong data-deferred-status>loading…</strong>
            </div>
          </HomepageWeather>
          <div>
            <span>listening</span><strong
              data-live-listening
              title="Checking listening activity"
              aria-live="polite">checking…</strong
            >
          </div>
        </div>
      </aside>
    </section>

    <section class="index-facts" aria-label="A few facts about Boston">
      <div><span>fact</span><strong>self-taught developer</strong></div>
      <div><span>also</span><strong>former grocery store bagger</strong></div>
      <div>
        <span>nearby</span>
        <strong
          >Mom + Mikey
          <svg
            class="index-cat-icon index-cat-icon-mikey"
            viewBox="0 0 18 18"
            width="13"
            height="13"
            fill="#ba7047"
            aria-hidden="true"
          >
            <path
              d="M2 3.3 6.1 5.5A7.4 7.4 0 0 1 9 4.9c1 0 2 .2 2.9.6L16 3.3l-.8 5.1c.5.9.8 1.8.8 2.8 0 3.2-3.1 5.6-7 5.6s-7-2.4-7-5.6c0-1 .3-1.9.8-2.8L2 3.3Z"
            ></path>
          </svg>
        </strong>
      </div>
      <div>
        <span>always</span>
        <strong
          >Grandma + Sasha
          <svg
            class="index-cat-icon index-cat-icon-sasha"
            viewBox="0 0 18 18"
            width="13"
            height="13"
            fill="#8993a4"
            aria-hidden="true"
          >
            <path
              d="M2 3.3 6.1 5.5A7.4 7.4 0 0 1 9 4.9c1 0 2 .2 2.9.6L16 3.3l-.8 5.1c.5.9.8 1.8.8 2.8 0 3.2-3.1 5.6-7 5.6s-7-2.4-7-5.6c0-1 .3-1.9.8-2.8L2 3.3Z"
            ></path>
          </svg>
        </strong>
      </div>
    </section>

    <section class="index-today" id="today" aria-labelledby="today-title">
      <div class="index-rule"></div>
      <div class="index-today-heading">
        <h2 id="today-title">Today</h2>
        <time data-today-date>today</time>
      </div>
      <div class="index-daily-context" aria-label="Daily context">
        <HomepageFitness server:defer>
          <div slot="fallback" class="index-fitness-placeholder">
            <div class="index-fitness-rings-wrap" aria-hidden="true"></div>
            <div>
              <span>movement</span><strong data-deferred-status>Loading…</strong
              ><small>Checking fitness activity</small>
            </div>
          </div>
        </HomepageFitness>
        <HomepageAiActivity server:defer>
          <div
            slot="fallback"
            class="index-ai-daily"
            aria-label="Daily AI activity"
          >
            <div class="index-ai-daily-copy">
              <span>AI activity</span><strong data-deferred-status
                >Loading…</strong
              ><small>Checking activity</small>
            </div>
          </div>
        </HomepageAiActivity>
      </div>
    </section>

    <section
      class="index-experience"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="index-section-heading">
        <h2 id="experience-title">Experience</h2>
        <p>where the work has happened</p>
      </div>
      <div class="index-experience-list">
        {
          experienceJobs.map((job) => (
            <div
              class:list={[
                "index-experience-row",
                job.roles.length > 1 && "index-experience-row-progressed",
              ]}
            >
              <a
                class="index-experience-company-link"
                href={job.website}
                target="_blank"
                rel="noreferrer"
                style={`--company-color: ${job.brandColor}`}
                aria-label={`Visit ${job.title} website (opens in a new tab)`}
              >
                <span class="index-experience-logo" aria-hidden="true">
                  {job.logo?.src ? (
                    <img src={job.logo.src} alt="" />
                  ) : (
                    job.icon?.type && <Icon name={job.icon.type} />
                  )}
                </span>
                <span class="index-experience-company">{job.title}</span>
                <span class="index-experience-arrow" aria-hidden="true">
                  <Icon name="external-link" />
                </span>
              </a>
              <div class="index-experience-roles">
                {job.roles.map((role, roleIndex) => (
                  <div
                    class:list={{
                      "index-experience-role-current": roleIndex === 0,
                      "index-experience-role-previous": roleIndex > 0,
                    }}
                  >
                    <span>{role.title}</span>
                  </div>
                ))}
              </div>
              <span class="index-list-meta index-experience-meta">
                <span>{job.tenure || job.roles[0]?.tenure}</span>
                {job.current && (
                  <span class="index-current-status">
                    <i /> current
                  </span>
                )}
              </span>
            </div>
          ))
        }
        {
          otherExperience.map((job) => (
            <div class="index-experience-row index-experience-other">
              <span class="index-experience-company">{job.title}</span>
              <span>{job.role}</span>
              <span class="index-list-meta index-experience-meta">
                <span>{job.tenure}</span>
                {job.current && (
                  <span class="index-current-status">
                    <i /> current
                  </span>
                )}
              </span>
            </div>
          ))
        }
      </div>
      <a
        class="index-text-link index-resume-link"
        href="https://docs.google.com/document/d/1BvBHf1BrVKDeNDExG4-vrVuik2-46lkkHsRJjDHbLyI/edit?usp=sharing"
        target="_blank">full resume <span>↗</span></a
      >
    </section>

    <section class="index-life" aria-labelledby="life-title">
      <div class="index-section-heading">
        <h2 id="life-title">Making + living</h2>
        <p>the things and people around the work</p>
      </div>
      <div class="index-life-grid index-life-grid-visual">
        <a
          class="index-life-card index-life-card-featured"
          href="https://www.courtneyrohanyoga.com/"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Courtney Rohan Yoga (opens in a new tab)"
        >
          <div class="index-life-media" data-life-image>
            <Image
              src={momPhoto}
              alt="Boston's mom smiling at an art exhibition"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
          </div>
          <span>people</span><strong>Mom</strong><small
            >present, every day</small
          >
        </a>
        <HomepageMusic server:defer>
          <a
            slot="fallback"
            class="index-life-card index-life-card-music"
            href="https://www.last.fm/user/bostonrohan"
            target="_blank"
          >
            <div class="index-life-media" data-life-image>
              <div class="index-life-slot">album art</div>
            </div>
            <span>on repeat</span><strong data-deferred-status>Loading…</strong
            ><small>Last.fm ↗</small>
          </a>
        </HomepageMusic>
        <HomepageWatching server:defer>
          <a
            slot="fallback"
            class="index-life-card index-life-card-anime"
            href="https://anilist.co/user/bosston/animelist"
            target="_blank"
          >
            <div class="index-life-media" data-life-image>
              <div class="index-life-slot">cover art</div>
            </div>
            <span>last watched</span><strong data-deferred-status
              >Loading…</strong
            ><small>AniList ↗</small>
          </a>
        </HomepageWatching>
        <div class="index-life-card index-life-card-mikey">
          <div class="index-life-media" data-life-image>
            <Image
              src={mikeyPhoto}
              alt="Mikey looking up while stretched out on the carpet"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
          </div>
          <span>people</span><strong>Mikey</strong><small
            >present, usually nearby</small
          >
        </div>
        <div
          class="index-life-card index-life-card-remembered index-life-card-grandma"
        >
          <div class="index-life-media" data-life-image>
            <Image
              src={grandmaPhoto}
              alt="Boston's grandma sitting with him on a floral couch"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
            <span class="index-memory-halo" aria-hidden="true"></span>
          </div>
          <span class="index-remembered-label"
            >in loving memory <Icon name="dove" aria-hidden="true" /></span
          ><strong>Grandma</strong><small>always</small>
        </div>
        <div
          class="index-life-card index-life-card-remembered index-life-card-sasha"
        >
          <div class="index-life-media" data-life-image>
            <Image
              src={sashaPhoto}
              alt="Sasha resting by a window at sunset"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
            <span class="index-memory-halo" aria-hidden="true"></span>
          </div>
          <span class="index-remembered-label"
            >in loving memory <Icon name="dove" aria-hidden="true" /></span
          ><strong>Sasha</strong><small>always</small>
        </div>
        <button
          class="index-life-card index-life-card-journal"
          type="button"
          aria-haspopup="dialog"
          aria-controls="journal-viewer"
          data-journal-open
        >
          <div class="index-life-media" data-life-image>
            <Image
              src={journalEntryPhoto}
              alt="Open handwritten journal entry titled Taking a Step"
              width={900}
              height={683}
              format="webp"
              quality={82}
              loading="lazy"
            />
          </div>
          <span>journal · Apr 18, 2020</span><strong>Taking a Step</strong
          ><small>open entry</small>
        </button>
      </div>
    </section>

    <dialog
      class="index-journal-viewer"
      id="journal-viewer"
      aria-labelledby="journal-viewer-title"
      data-journal-viewer
    >
      <div class="index-journal-viewer-bar">
        <div>
          <time datetime="2020-04-18">April 18, 2020</time>
          <strong id="journal-viewer-title">Taking a Step</strong>
        </div>
        <button type="button" data-journal-close>close</button>
      </div>
      <div class="index-journal-viewer-stage">
        <div class="index-life-media index-journal-viewer-media">
          <Image
            src={journalEntryDetail}
            alt="Open handwritten journal entry titled Taking a Step, dated April 18, 2020"
            width={1660}
            height={2340}
            format="webp"
            quality={88}
            loading="lazy"
          />
        </div>
        <article
          class="index-journal-transcription"
          aria-label="Transcription of Taking a Step"
        >
          <p>
            So, I am new to this whole journal thing. I just hope that this
            allows me to improve myself in every aspect of life. So I will use
            this however I feel is necessary. Being in lockdown makes me want to
            do these things to better myself. I know whenever I need this it
            will be here, and for that I am grateful.
          </p>
          <p>Things I’m grateful for:</p>
          <ol>
            <li>My job</li>
            <li>My room</li>
            <li>My clothes</li>
            <li>My attitude</li>
            <li>Life</li>
            <li>My parents</li>
          </ol>
          <blockquote>
            “When we are no longer able to change the situation, we are
            challenged to change ourselves.” <cite>— Viktor Frankl</cite>
          </blockquote>
          <p>What is my “why”?</p>
        </article>
      </div>
    </dialog>

    <section class="index-contact" id="contact" aria-labelledby="contact-title">
      <div class="index-section-heading">
        <h2 id="contact-title">Contact</h2>
        <p>if you want to talk about something, I would like that</p>
      </div>
      <div class="index-contact-row">
        <p>
          Schedule a call, or find me on <a
            href="https://www.linkedin.com/in/bostonrohan/"
            target="_blank">LinkedIn</a
          > and <a href="https://github.com/BostonRohan" target="_blank"
            >GitHub</a
          >.
        </p>
        <div class="index-contact-links">
          <a href="mailto:bostonrohan@gmail.com">email <span>↗</span></a><a
            href="#home">back to top <span>↑</span></a
          >
        </div>
      </div>
      <Cal client:only="react">
        <p slot="fallback">Loading booking calendar…</p>
      </Cal>
    </section>

    <footer class="index-footer">
      <span>Boston Rohan</span><span>built slowly, in public</span>
    </footer>
  </main>
  <script is:inline>
    const livePresence = document.querySelector("[data-live-presence]");
    const livePresenceText = document.querySelector(
      "[data-live-presence-text]",
    );
    const liveListening = document.querySelector("[data-live-listening]");
    let isPresenceLoading = false;
    let isListeningLoading = false;

    async function refreshPresence() {
      if (!livePresence || !livePresenceText || isPresenceLoading) return;
      isPresenceLoading = true;
      try {
        const response = await fetch("/api/presence");
        if (!response.ok)
          throw new Error(`Presence request failed: ${response.status}`);
        const data = await response.json();
        const statusText = data.statusText || "unavailable";
        livePresence.dataset.status = data.status || "unknown";
        livePresence.title = statusText;
        if (livePresenceText.textContent !== statusText) {
          livePresenceText.textContent = statusText;
        }
      } catch {
        livePresence.dataset.status = "unknown";
        livePresence.title = "unavailable";
        if (livePresenceText.textContent !== "unavailable") {
          livePresenceText.textContent = "unavailable";
        }
      } finally {
        isPresenceLoading = false;
      }
    }

    async function refreshListening() {
      if (!liveListening || isListeningLoading) return;
      isListeningLoading = true;
      try {
        const response = await fetch("/api/now-playing");
        if (!response.ok)
          throw new Error(`Now-playing request failed: ${response.status}`);
        const data = await response.json();
        const label = data.error
          ? "unavailable"
          : data.track
            ? `${data.track.name} — ${data.track.artist}`
            : "nothing right now";
        if (liveListening.textContent !== label) {
          liveListening.textContent = label;
        }
        liveListening.title = label;
      } catch {
        if (liveListening.textContent !== "unavailable") {
          liveListening.textContent = "unavailable";
        }
        liveListening.title = "unavailable";
      } finally {
        isListeningLoading = false;
      }
    }

    function refreshLiveActivity() {
      if (document.hidden) return;
      void refreshPresence();
      void refreshListening();
    }

    refreshLiveActivity();
    window.setInterval(refreshLiveActivity, 60_000);
    document.addEventListener("visibilitychange", refreshLiveActivity);

    window.setTimeout(() => {
      document.querySelectorAll("[data-deferred-status]").forEach((status) => {
        status.textContent = "Temporarily unavailable";
      });
    }, 8_000);

    const nameplate = document.querySelector("[data-season]");
    if (nameplate) {
      const month = Number(
        new Intl.DateTimeFormat("en-US", {
          timeZone: "America/New_York",
          month: "numeric",
        }).format(new Date()),
      );
      const season =
        month >= 3 && month <= 5
          ? "spring"
          : month >= 6 && month <= 8
            ? "summer"
            : month >= 9 && month <= 11
              ? "autumn"
              : "winter";
      nameplate.setAttribute("data-season", season);
    }

    const todayDate = document.querySelector("[data-today-date]");
    if (todayDate) {
      const now = new Date();
      const todayKey = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/New_York",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(now);
      todayDate.setAttribute("datetime", todayKey);
      todayDate.textContent = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/New_York",
        month: "2-digit",
        day: "2-digit",
        year: "2-digit",
      }).format(now);
    }

    const fallbackColors = ["#526a9d", "#81566e", "#7a6548", "#3e7568"];
    const initializedLifeImages = new WeakSet();

    function setLifeColor(media, red, green, blue) {
      const color = `rgb(${red}, ${green}, ${blue})`;
      media.style.setProperty("--life-color", color);
      media.style.setProperty(
        "--life-color-soft",
        `rgba(${red}, ${green}, ${blue}, .34)`,
      );
    }

    function initializeLifeImage(image, index) {
      if (initializedLifeImages.has(image)) return;
      initializedLifeImages.add(image);
      const media = image.closest("[data-life-image]");
      if (!media) return;

      const fallback = fallbackColors[index % fallbackColors.length];
      media.style.setProperty("--life-color", fallback);
      media.style.setProperty("--life-color-soft", `${fallback}55`);

      const extractLifeColor = () => {
        try {
          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d", { willReadFrequently: true });
          if (!context) return;
          canvas.width = 24;
          canvas.height = 24;
          context.drawImage(image, 0, 0, 24, 24);
          const pixels = context.getImageData(0, 0, 24, 24).data;
          let red = 0;
          let green = 0;
          let blue = 0;
          let count = 0;

          for (let pixel = 0; pixel < pixels.length; pixel += 16) {
            if (pixels[pixel + 3] < 180) continue;
            red += pixels[pixel];
            green += pixels[pixel + 1];
            blue += pixels[pixel + 2];
            count += 1;
          }

          if (count)
            setLifeColor(
              media,
              Math.round(red / count),
              Math.round(green / count),
              Math.round(blue / count),
            );
        } catch {
          // The card keeps its calm fallback color if sampling fails.
        }
      };

      image.addEventListener("load", extractLifeColor, { once: true });
      if (image.complete && image.naturalWidth) extractLifeColor();
    }

    function initializeLifeImages() {
      document
        .querySelectorAll("[data-life-image] img")
        .forEach(initializeLifeImage);
    }

    initializeLifeImages();
    const lifeGrid = document.querySelector(".index-life-grid");
    if (lifeGrid) {
      new MutationObserver(initializeLifeImages).observe(lifeGrid, {
        childList: true,
        subtree: true,
      });
    }

    function closeDetails(container) {
      if (!container) return;
      container.classList.remove("is-open");
      container.querySelector("button")?.setAttribute("aria-expanded", "false");
    }

    document.addEventListener("click", (event) => {
      const button = event.target.closest(
        "[data-fitness-rings] > button, [data-ai-history] > button",
      );
      if (!button || button.disabled) return;
      const container = button.parentElement;
      const isOpen = container.classList.toggle("is-open");
      button.setAttribute("aria-expanded", String(isOpen));
    });
    document.addEventListener("pointerdown", (event) => {
      for (const selector of ["[data-fitness-rings]", "[data-ai-history]"]) {
        const container = document.querySelector(selector);
        if (container && !container.contains(event.target))
          closeDetails(container);
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      for (const selector of ["[data-fitness-rings]", "[data-ai-history]"]) {
        const container = document.querySelector(selector);
        if (container?.classList.contains("is-open")) {
          closeDetails(container);
          container.querySelector("button")?.blur();
        }
      }
    });

    const journalViewer = document.querySelector("[data-journal-viewer]");
    const journalOpen = document.querySelector("[data-journal-open]");
    const journalClose = journalViewer?.querySelector("[data-journal-close]");
    if (journalViewer && journalOpen && journalClose) {
      const closeJournal = () => {
        journalViewer.close();
      };

      journalOpen.addEventListener("click", () => {
        journalViewer.showModal();
        document.body.style.overflow = "hidden";
      });
      journalClose.addEventListener("click", closeJournal);
      journalViewer.addEventListener("click", (event) => {
        if (event.target === journalViewer) closeJournal();
      });
      journalViewer.addEventListener("close", () => {
        document.body.style.removeProperty("overflow");
        journalOpen.focus();
      });
    }
  </script>
</Layout>
