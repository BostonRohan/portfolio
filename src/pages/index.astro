---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import Layout from "../layouts/Layout.astro";
import Cal from "../components/react/Cal.tsx";
import blogs from "../utils/blogs";
import { fetchLastfmData } from "../utils/lastfm.js";
import { fetchAnilistData } from "../utils/anilist.js";
import { fetchLetterboxdActivity } from "../utils/letterboxd.js";
import { fetchDiscordPresence } from "../utils/discord.js";
import { fetchCharlotteWeather } from "../utils/weather.js";
import { getFitnessData } from "../utils/fitness.ts";
import { getAiActivity } from "../utils/aiActivity.ts";
import { musicProfile } from "../data/music.js";
import { experienceJobs, otherExperience } from "../data/portfolio.js";
import bostonHeadshot from "../assets/boston_headshot.jpg";
import grandmaPhoto from "../assets/grandma.webp";
import mikeyPhoto from "../assets/mikey.webp";
import momPhoto from "../assets/mom.webp";
import sashaPhoto from "../assets/sasha.webp";

const proxyMediaImage = (url: string): string =>
  `/api/media-image?url=${encodeURIComponent(url)}`;

const [
  lastfmData,
  anilistData,
  letterboxdData,
  discordPresence,
  weather,
  fitnessData,
  aiActivityData,
] = await Promise.all([
  fetchLastfmData({
    apiKey: import.meta.env.LASTFM_API_KEY,
    username: import.meta.env.LASTFM_USERNAME || musicProfile.lastfmUsername,
    recentTrackLimit: 1,
    topArtistLimit: 3,
    topAlbumLimit: 3,
  }),
  fetchAnilistData(import.meta.env.ANILIST_USERNAME || "bosston"),
  fetchLetterboxdActivity({
    username: import.meta.env.LETTERBOXD_USERNAME,
  }),
  fetchDiscordPresence({ userId: import.meta.env.DISCORD_USER_ID }),
  fetchCharlotteWeather(),
  getFitnessData(),
  getAiActivity(),
]);

const latestWorkout = fitnessData.workout;
const fitnessRings = fitnessData.rings;
const easternDateKey = (value: Date): string =>
  new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(value);
const workoutDate = latestWorkout?.completedAt
  ? new Date(latestWorkout.completedAt)
  : null;
const isWorkoutToday = Boolean(
  workoutDate &&
    !Number.isNaN(workoutDate.getTime()) &&
    easternDateKey(workoutDate) === easternDateKey(new Date()),
);
const todaysWorkout = isWorkoutToday ? latestWorkout : null;
const withUnit = (value: string | null, unit: string): string | null =>
  value && /^\d+(?:\.\d+)?$/.test(value.trim())
    ? `${value.trim()} ${unit}`
    : value;
const workoutDetails = todaysWorkout
  ? [
      withUnit(todaysWorkout.duration, "min"),
      todaysWorkout.distance,
      withUnit(todaysWorkout.activeEnergy, "kcal"),
    ]
      .filter(Boolean)
      .join(" · ")
  : "No workout logged today";
const ringLabel = fitnessRings
  ? `Move ${Math.round(fitnessRings.move)}%, exercise ${Math.round(fitnessRings.exercise)}%, stand ${Math.round(fitnessRings.stand)}%`
  : "Apple Watch fitness rings not connected";
const ringDash = (
  progress: number | undefined,
  circumference: number,
): string =>
  progress === undefined
    ? `${circumference} 0`
    : `${((Math.min(progress, 100) / 100) * circumference).toFixed(1)} ${circumference}`;

const recentTrack = lastfmData.recentTracks[0];
const weatherLabel =
  weather.temperature === null
    ? weather.condition
    : `${weather.temperature}°F · ${weather.condition}`;
const listeningLabel = lastfmData.error
  ? "unavailable"
  : recentTrack
    ? `${recentTrack.name} — ${recentTrack.artist}`
    : "nothing recently";
const latestWatch = [anilistData.recentActivity, letterboxdData.entry]
  .filter(Boolean)
  .sort((a, b) => b.updatedAt - a.updatedAt)[0];
const currentAlbum = lastfmData.topAlbums[0];
const currentAlbumMeta = currentAlbum
  ? `${currentAlbum.artist} · ${currentAlbum.playcount} ${currentAlbum.playcount === "1" ? "play" : "plays"}`
  : "Last.fm ↗";
const shortDate = new Intl.DateTimeFormat("en-US", {
  month: "2-digit",
  day: "2-digit",
  year: "2-digit",
}).format(new Date());
const todayDateKey = easternDateKey(new Date());
const aiActivityDateKey = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/New_York",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());
const aiActivity =
  aiActivityData?.date === aiActivityDateKey ? aiActivityData : null;
const aiSessionCount = aiActivity
  ? aiActivity.providers.codex.sessions + aiActivity.providers.claude.sessions
  : 0;
const aiToolCount = aiActivity
  ? aiActivity.providers.codex.toolCalls + aiActivity.providers.claude.toolCalls
  : 0;
const aiActivitySummary = aiActivity
  ? `${aiSessionCount} ${aiSessionCount === 1 ? "session" : "sessions"} · ${aiToolCount} ${aiToolCount === 1 ? "tool" : "tools"}`
  : "No activity synced today";
const aiActivityDetail = aiActivity
  ? `Codex ${aiActivity.providers.codex.sessions}/${aiActivity.providers.codex.toolCalls} · Claude ${aiActivity.providers.claude.sessions}/${aiActivity.providers.claude.toolCalls}`
  : "Codex + Claude";
const initialSeason = (() => {
  const month = new Date().getMonth() + 1;
  if (month >= 3 && month <= 5) return "spring";
  if (month >= 6 && month <= 8) return "summer";
  if (month >= 9 && month <= 11) return "autumn";
  return "winter";
})();
---

<Layout>
  <main class="index-page" id="home">
    <nav class="index-nav" aria-label="Main navigation">
      <a class="index-mark" href="#home">BR / 26</a>
      <div class="index-nav-links">
        <a href="#today">today</a>
        <a href="#experience">experience</a>
        <a href="#contact">contact</a>
      </div>
    </nav>

    <section class="index-hero" aria-labelledby="intro-title">
      <div class="index-hero-copy">
        <div class="index-nameplate" data-season={initialSeason}>
          <h1 id="intro-title">Boston<br />Rohan</h1>
          <div class="index-seasonal-accent" aria-hidden="true">
            <svg class="season-art season-art-autumn" viewBox="0 0 220 100">
              <g class="season-leaf season-leaf-one"
                ><path d="M4 3C19 -3 34 2 42 13C30 22 15 20 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C18 9 28 12 39 14"></path></g
              >
              <g class="season-leaf season-leaf-two"
                ><path d="M4 3C15 -2 28 3 35 13C25 20 12 17 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C16 8 24 11 33 13"></path></g
              >
              <g class="season-leaf season-leaf-three"
                ><path d="M4 3C17 -4 30 1 36 12C25 19 12 17 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C16 8 25 10 34 12"></path></g
              >
              <g class="season-leaf season-leaf-four"
                ><path d="M4 3C18 -3 32 2 40 13C28 21 14 19 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C17 9 27 11 38 13"></path></g
              >
              <g class="season-leaf season-leaf-five"
                ><path d="M4 3C16 -2 27 2 34 11C24 18 12 16 4 3Z"></path><path
                  class="season-leaf-vein"
                  d="M6 4C15 8 23 10 32 11"></path></g
              >
            </svg>
            <svg class="season-art season-art-winter" viewBox="0 0 220 100">
              <circle
                class="season-flake season-flake-one"
                cx="32"
                cy="17"
                r="2"></circle>
              <circle
                class="season-flake season-flake-two"
                cx="76"
                cy="38"
                r="1.5"></circle>
              <circle
                class="season-flake season-flake-three"
                cx="151"
                cy="23"
                r="2"></circle>
              <circle
                class="season-flake season-flake-four"
                cx="190"
                cy="68"
                r="1.5"></circle>
            </svg>
            <svg class="season-art season-art-spring" viewBox="0 0 220 100">
              <path
                class="season-sprout"
                d="M33 88C34 67 43 50 60 38M44 62C32 58 27 50 29 42C39 44 46 51 44 62ZM48 53C53 40 62 34 72 35C70 46 61 53 48 53Z"
              ></path>
              <path
                class="season-sprout season-sprout-two"
                d="M170 92C170 74 178 61 190 51M177 73C166 70 162 64 164 57C173 59 179 64 177 73Z"
              ></path>
            </svg>
            <svg class="season-art season-art-summer" viewBox="0 0 220 100">
              <circle class="season-sun" cx="175" cy="27" r="9"></circle>
              <path
                class="season-ray"
                d="M175 8V2M175 52V46M156 27H150M200 27H194M161 13L157 9M193 45L189 41M189 13L193 9M157 45L161 41"
              ></path>
            </svg>
          </div>
        </div>
        <p>
          Developer, builder, and person trying to pay attention. Currently
          working at <a href="https://elevationchurch.org/" target="_blank"
            >Elevation Church</a
          >.
        </p>
        <div class="index-current-curiosity">
          <span>currently curious about</span>
          <p>What belongs on a personal website now?</p>
        </div>
      </div>
      <aside class="index-now-rail" aria-label="Current state">
        <Image
          class="index-portrait"
          src={bostonHeadshot}
          alt="Boston Rohan smiling against a dark backdrop"
          width={840}
          height={1050}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
        <div class="index-now-list">
          <div>
            <span>status</span><strong
              class="index-presence"
              data-status={discordPresence.status}
              title={discordPresence.statusText}
              ><i aria-hidden="true"></i>{discordPresence.statusText}</strong
            >
          </div>
          <div><span>place</span><strong>Charlotte, NC</strong></div>
          <div>
            <span>weather</span><strong title={weatherLabel}
              >{weatherLabel}</strong
            >
          </div>
          <div>
            <span>listening</span><strong title={listeningLabel}
              >{listeningLabel}</strong
            >
          </div>
        </div>
      </aside>
    </section>

    <section class="index-facts" aria-label="A few facts about Boston">
      <div><span>fact</span><strong>self-taught developer</strong></div>
      <div><span>also</span><strong>former grocery store bagger</strong></div>
      <div><span>nearby</span><strong>Mom + Mikey</strong></div>
      <div><span>always</span><strong>Grandma + Sasha</strong></div>
    </section>

    <section class="index-today" id="today" aria-labelledby="today-title">
      <div class="index-rule"></div>
      <div class="index-today-heading">
        <h2 id="today-title">Today</h2>
        <time datetime={todayDateKey}>{shortDate}</time>
      </div>
      <div class="index-daily-context" aria-label="Daily context">
        <div class="index-fitness-placeholder">
          <div class="index-fitness-rings-wrap" data-fitness-rings>
            <button
              class="index-fitness-rings"
              class:list={{ "is-active": Boolean(fitnessRings) }}
              type="button"
              aria-label={ringLabel}
              aria-describedby={fitnessRings
                ? "fitness-ring-details"
                : undefined}
              aria-expanded="false"
              disabled={!fitnessRings}
            >
              <svg viewBox="0 0 96 96" role="img" aria-hidden="true">
                <circle
                  class="index-ring-track index-ring-move"
                  cx="48"
                  cy="48"
                  r="40"></circle>
                <circle
                  class="index-ring-track index-ring-exercise"
                  cx="48"
                  cy="48"
                  r="30"></circle>
                <circle
                  class="index-ring-track index-ring-stand"
                  cx="48"
                  cy="48"
                  r="20"></circle>
                <circle
                  class="index-ring index-ring-move"
                  cx="48"
                  cy="48"
                  r="40"
                  style={`stroke-dasharray: ${ringDash(fitnessRings?.move, 252)}`}
                ></circle>
                <circle
                  class="index-ring index-ring-exercise"
                  cx="48"
                  cy="48"
                  r="30"
                  style={`stroke-dasharray: ${ringDash(fitnessRings?.exercise, 188)}`}
                ></circle>
                <circle
                  class="index-ring index-ring-stand"
                  cx="48"
                  cy="48"
                  r="20"
                  style={`stroke-dasharray: ${ringDash(fitnessRings?.stand, 126)}`}
                ></circle>
              </svg>
            </button>
            {
              fitnessRings && (
                <div
                  class="index-fitness-tooltip"
                  id="fitness-ring-details"
                  role="tooltip"
                >
                  <div>
                    <i class="is-move" />
                    <span>Move</span>
                    <strong>{Math.round(fitnessRings.move)}%</strong>
                  </div>
                  <div>
                    <i class="is-exercise" />
                    <span>Exercise</span>
                    <strong>{Math.round(fitnessRings.exercise)}%</strong>
                  </div>
                  <div>
                    <i class="is-stand" />
                    <span>Stand</span>
                    <strong>{Math.round(fitnessRings.stand)}%</strong>
                  </div>
                </div>
              )
            }
          </div>
          <div>
            <span>movement</span><strong
              >{todaysWorkout?.workoutType || "Rest day"}</strong
            ><small>{workoutDetails}</small>
          </div>
        </div>
        <div class="index-context-line">
          <span>ai</span><strong>{aiActivitySummary}</strong><small
            title="Sessions / tool calls">{aiActivityDetail}</small
          >
        </div>
      </div>
    </section>

    <section
      class="index-experience"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="index-section-heading">
        <h2 id="experience-title">Experience</h2>
        <p>where the work has happened</p>
      </div>
      <div class="index-experience-list">
        {
          experienceJobs.map((job) => (
            <div class="index-experience-row">
              <a
                class="index-experience-company-link"
                href={job.website}
                target="_blank"
                rel="noreferrer"
                style={`--company-color: ${job.brandColor}`}
                aria-label={`Visit ${job.title} website (opens in a new tab)`}
              >
                <span class="index-experience-logo" aria-hidden="true">
                  {job.logo?.src ? (
                    <img src={job.logo.src} alt="" />
                  ) : (
                    job.icon?.type && <Icon name={job.icon.type} />
                  )}
                </span>
                <span class="index-experience-company">{job.title}</span>
                <span class="index-experience-arrow" aria-hidden="true">
                  <Icon name="external-link" />
                </span>
              </a>
              <span>{job.roles[0]?.title}</span>
              <span class="index-list-meta index-experience-meta">
                <span>{job.tenure || job.roles[0]?.tenure}</span>
                {job.current && (
                  <span class="index-current-status">
                    <i /> current
                  </span>
                )}
              </span>
            </div>
          ))
        }
        {
          otherExperience.map((job) => (
            <div class="index-experience-row index-experience-other">
              <span class="index-experience-company">{job.title}</span>
              <span>{job.role}</span>
              <span class="index-list-meta">{job.tenure}</span>
            </div>
          ))
        }
      </div>
      <a
        class="index-text-link index-resume-link"
        href="https://docs.google.com/document/d/1BvBHf1BrVKDeNDExG4-vrVuik2-46lkkHsRJjDHbLyI/edit?usp=sharing"
        target="_blank">full resume <span>↗</span></a
      >
    </section>

    <section class="index-life" aria-labelledby="life-title">
      <div class="index-section-heading">
        <h2 id="life-title">Making + living</h2>
        <p>the things and people around the work</p>
      </div>
      <div class="index-life-grid index-life-grid-visual">
        <a
          class="index-life-card index-life-card-featured"
          href="https://www.courtneyrohanyoga.com/"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Courtney Rohan Yoga (opens in a new tab)"
        >
          <div class="index-life-media" data-life-image>
            <Image
              src={momPhoto}
              alt="Boston's mom smiling at an art exhibition"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
          </div>
          <span>people</span><strong>Mom</strong><small
            >present, every day</small
          >
        </a>
        <a
          class="index-life-card index-life-card-music"
          href="https://www.last.fm/user/bostonrohan"
          target="_blank"
        >
          <div class="index-life-media" data-life-image>
            {
              currentAlbum?.image ? (
                <img
                  src={proxyMediaImage(currentAlbum.image)}
                  alt={`Album artwork for ${currentAlbum.name}`}
                />
              ) : (
                <div class="index-life-slot">album art</div>
              )
            }
          </div>
          <span>on repeat</span><strong
            >{currentAlbum?.name || "what has been playing"}</strong
          ><small>{currentAlbumMeta}</small>
        </a>
        <a
          class="index-life-card index-life-card-anime"
          href={latestWatch?.url || "https://anilist.co/user/bosston/animelist"}
          target="_blank"
        >
          <div class="index-life-media" data-life-image>
            {
              latestWatch?.coverImage ? (
                <img
                  src={proxyMediaImage(latestWatch.coverImage)}
                  alt={`Poster for ${latestWatch.title}`}
                />
              ) : (
                <div class="index-life-slot">cover art</div>
              )
            }
          </div>
          <span>last watched</span><strong
            >{latestWatch?.title || "what I have been watching"}</strong
          ><small
            >{latestWatch ? `${latestWatch.source} ↗` : "AniList ↗"}</small
          >
        </a>
        <div class="index-life-card">
          <div class="index-life-media" data-life-image>
            <Image
              src={mikeyPhoto}
              alt="Mikey looking up while stretched out on the carpet"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
          </div>
          <span>people</span><strong>Mikey</strong><small
            >present, usually nearby</small
          >
        </div>
        <div class="index-life-card index-life-card-remembered">
          <div class="index-life-media" data-life-image>
            <Image
              src={grandmaPhoto}
              alt="Boston's grandma sitting with him on a floral couch"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
            <span class="index-memory-halo" aria-hidden="true"></span>
          </div>
          <span class="index-remembered-label"
            >in loving memory <Icon name="dove" aria-hidden="true" /></span
          ><strong>Grandma</strong><small>always</small>
        </div>
        <div class="index-life-card index-life-card-remembered">
          <div class="index-life-media" data-life-image>
            <Image
              src={sashaPhoto}
              alt="Sasha resting by a window at sunset"
              width={400}
              height={400}
              densities={[1, 2, 3]}
              format="webp"
              quality={85}
              loading="lazy"
            />
            <span class="index-memory-halo" aria-hidden="true"></span>
          </div>
          <span class="index-remembered-label"
            >in loving memory <Icon name="dove" aria-hidden="true" /></span
          ><strong>Sasha</strong><small>always</small>
        </div>
        <div class="index-life-card index-life-card-journal">
          <div class="index-life-media" data-life-image>
            <div class="index-life-slot index-life-slot-journal">
              journal scan / handwritten fragment
            </div>
          </div>
          <span>notes</span><strong>something I was trying to understand</strong
          ><small>from the notebook</small>
        </div>
      </div>
    </section>

    <section class="index-writing" aria-labelledby="writing-title">
      <div class="index-section-heading">
        <h2 id="writing-title">Notes</h2>
        <p>things I have tried to put into words</p>
      </div>
      <div class="index-notes-list">
        {
          blogs.slice(0, 3).map((blog) => (
            <a
              class="index-note-row"
              href={`/blog/${blog.title.replace(/\s+/g, "-").toLowerCase()}`}
            >
              <>
                <span>{blog.date}</span>
                <strong>{blog.title}</strong>
                <span>{blog.readTime} read</span>
              </>
            </a>
          ))
        }
      </div>
    </section>

    <section class="index-tools" aria-labelledby="tools-title">
      <div class="index-section-heading">
        <h2 id="tools-title">What I use</h2>
        <p>hardware, software, current tools</p>
      </div>
      <div class="index-tools-grid">
        <div class="index-tool-row">
          <strong>GitHub</strong><span>code</span>
        </div>
        <div class="index-tool-row">
          <strong>Claude + Codex</strong><span>thinking with</span>
        </div>
        <div class="index-tool-row">
          <strong>Apple Watch</strong><span>movement</span>
        </div>
        <div class="index-tool-row">
          <strong>Last.fm + AniList</strong><span>media</span>
        </div>
      </div>
    </section>

    <section class="index-contact" id="contact" aria-labelledby="contact-title">
      <div class="index-section-heading">
        <h2 id="contact-title">Contact</h2>
        <p>if you want to talk about something, I would like that</p>
      </div>
      <div class="index-contact-row">
        <p>
          Schedule a call, or find me on <a
            href="https://www.linkedin.com/in/bostonrohan/"
            target="_blank">LinkedIn</a
          > and <a href="https://github.com/BostonRohan" target="_blank"
            >GitHub</a
          >.
        </p>
        <div class="index-contact-links">
          <a href="mailto:bostonrohan@gmail.com">email <span>↗</span></a><a
            href="#home">back to top <span>↑</span></a
          >
        </div>
      </div>
      <Cal client:load />
    </section>

    <footer class="index-footer">
      <span>Boston Rohan</span><span>built slowly, in public</span>
    </footer>
  </main>
  <script is:inline>
    const nameplate = document.querySelector("[data-season]");
    if (nameplate) {
      const month = new Date().getMonth() + 1;
      const season =
        month >= 3 && month <= 5
          ? "spring"
          : month >= 6 && month <= 8
            ? "summer"
            : month >= 9 && month <= 11
              ? "autumn"
              : "winter";
      nameplate.setAttribute("data-season", season);
    }

    const lifeImages = document.querySelectorAll("[data-life-image] img");
    const fallbackColors = ["#526a9d", "#81566e", "#7a6548", "#3e7568"];

    function setLifeColor(media, red, green, blue) {
      const color = `rgb(${red}, ${green}, ${blue})`;
      media.style.setProperty("--life-color", color);
      media.style.setProperty(
        "--life-color-soft",
        `rgba(${red}, ${green}, ${blue}, .34)`,
      );
    }

    lifeImages.forEach((image, index) => {
      const media = image.closest("[data-life-image]");
      if (!media) return;

      const fallback = fallbackColors[index % fallbackColors.length];
      media.style.setProperty("--life-color", fallback);
      media.style.setProperty("--life-color-soft", `${fallback}55`);

      const extractLifeColor = () => {
        try {
          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d", { willReadFrequently: true });
          if (!context) return;
          canvas.width = 24;
          canvas.height = 24;
          context.drawImage(image, 0, 0, 24, 24);
          const pixels = context.getImageData(0, 0, 24, 24).data;
          let red = 0;
          let green = 0;
          let blue = 0;
          let count = 0;

          for (let pixel = 0; pixel < pixels.length; pixel += 16) {
            if (pixels[pixel + 3] < 180) continue;
            red += pixels[pixel];
            green += pixels[pixel + 1];
            blue += pixels[pixel + 2];
            count += 1;
          }

          if (count)
            setLifeColor(
              media,
              Math.round(red / count),
              Math.round(green / count),
              Math.round(blue / count),
            );
        } catch {
          // The card keeps its calm fallback color if sampling fails.
        }
      };

      image.addEventListener("load", extractLifeColor, { once: true });
      if (image.complete && image.naturalWidth) extractLifeColor();
    });

    const fitnessRings = document.querySelector("[data-fitness-rings]");
    const fitnessButton = fitnessRings?.querySelector("button");
    if (fitnessRings && fitnessButton && !fitnessButton.disabled) {
      const closeFitnessDetails = () => {
        fitnessRings.classList.remove("is-open");
        fitnessButton.setAttribute("aria-expanded", "false");
      };

      fitnessButton.addEventListener("click", () => {
        const isOpen = fitnessRings.classList.toggle("is-open");
        fitnessButton.setAttribute("aria-expanded", String(isOpen));
      });
      document.addEventListener("pointerdown", (event) => {
        if (!fitnessRings.contains(event.target)) closeFitnessDetails();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeFitnessDetails();
          fitnessButton.blur();
        }
      });
    }
  </script>
</Layout>
