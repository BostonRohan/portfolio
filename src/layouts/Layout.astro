---
import Nav from "../components/react/Nav.tsx";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  date?: string;
  //in seconds
  readingTime?: string;
}

const { title, description, image, imageAlt, date, readingTime } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(currentPath, siteUrl).toString();
const pageTitle = title || "Boston Rohan";
const pageDescription =
  description ||
  "Developer, builder, and person trying to pay attention. Currently working at Elevation Church.";
const defaultSocialImage = new URL("/og-image.jpg", siteUrl).toString();
const socialImage = image
  ? new URL(image, siteUrl).toString()
  : defaultSocialImage;
const socialImageAlt =
  imageAlt ||
  (image
    ? `Preview image for ${pageTitle}`
    : "Boston Rohan — developer and builder");
const openGraphType = date || readingTime ? "article" : "website";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="Boston Rohan" />
    <meta name="theme-color" content="#111214" />
    {
      isHome && (
        <style
          is:inline
          set:html={"html,body{margin:0;background:#111214;color-scheme:dark}"}
        />
      )
    }
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon_io/apple-touch-icon.png?v=3"
    />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon_io/favicon-32x32.png?v=3"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon_io/favicon-16x16.png?v=3"
    />
    <link rel="manifest" href="/favicon_io/site.webmanifest?v=3" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Boston Rohan" />
    <meta property="og:locale" content="en_US" />
    {
      readingTime && (
        <>
          <meta name="twitter:label1" content="Estimated Reading Time" />
          <meta name="twitter:data1" content={`${+readingTime / 60} minutes`} />
        </>
      )
    }
    {
      date && (
        <meta
          property="article:published_time"
          content={new Date(date).toISOString()}
        />
      )
    }
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      !image && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme") === "light"
        ) {
          return "light";
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "dark";
      })();

      if (theme === "light") {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.removeItem("theme");
      }
    </script>
  </head>
  <body
    class="dark:bg-zinc-900 transition duration-300 ease-in-out dark:text-neutral-400"
  >
    <div class:list={["site-shell", isHome && "site-shell-index"]}>
      {!isHome && <Nav client:load currentPath={currentPath} />}
      <slot />
    </div>
  </body>
</html>
